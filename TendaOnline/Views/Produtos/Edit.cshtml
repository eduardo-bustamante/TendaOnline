@model TendaOnline.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Editar Produto: @Model.Nome</h5>
                <span class="badge bg-light text-dark">Saldo: @Model.QuantidadeEstoque un</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Nome" class="form-label fw-bold">Nome do Produto</label>
                            <input asp-for="Nome" class="form-control" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CodigoBarras" class="form-label fw-bold">Código de Barras</label>
                            <input asp-for="CodigoBarras" class="form-control" />
                            <span asp-validation-for="CodigoBarras" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-bold">Categoria</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias" required></select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EstoqueMinimo" class="form-label fw-bold">Estoque Mínimo</label>
                            <input asp-for="EstoqueMinimo" type="number" min="0" class="form-control" />
                            <span asp-validation-for="EstoqueMinimo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PrecoCusto" class="form-label fw-bold">Preço de Custo (R$)</label>
                            <input asp-for="PrecoCusto" type="number" step="0.01" min="0" class="form-control" required />
                            <span asp-validation-for="PrecoCusto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PrecoVenda" class="form-label fw-bold">Preço de Venda (R$)</label>
                            <input asp-for="PrecoVenda" type="number" step="0.01" min="0" class="form-control" required />
                            <span asp-validation-for="PrecoVenda" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descricao" class="form-label fw-bold">Descrição</label>
                            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Ativo" />
                                <label class="form-check-label fw-bold" asp-for="Ativo">Produto ativo no sistema</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <small class="text-muted">
                            Cadastrado em: @Model.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </small>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                            <button type="submit" class="btn btn-primary px-4">Salvar Alterações</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}