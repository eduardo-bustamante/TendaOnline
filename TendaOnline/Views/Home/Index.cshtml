@model TendaOnline.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold">Painel de Controle</h2>
        <small class="text-muted">Acompanhe as vendas de hoje e os níveis do inventário</small>
    </div>
    <div>
        <a asp-controller="Vendas" asp-action="PDV" class="btn btn-success d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-cart-check fs-5"></i>
            <span>Ir para o PDV</span>
        </a>
    </div>
</div>

<!-- 4 Cards Superiores com Indicadores Principais -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Faturamento Hoje</span>
                    <h3 class="fw-bold mb-0 text-success mt-1">@Model.FaturamentoHoje.ToString("C")</h3>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Vendas do Dia</span>
                    <h3 class="fw-bold mb-0 text-primary mt-1">@Model.TotalVendasHoje</h3>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-receipt fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Ticket Médio (Hoje)</span>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@Model.TicketMedioHoje.ToString("C")</h3>
                </div>
                <div class="rounded-circle bg-dark-subtle text-dark p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Estoque Crítico</span>
                    <h3 class="fw-bold mb-0 @(Model.TotalItensAbaixoMinimo > 0 ? "text-danger" : "text-secondary") mt-1">
                        @Model.TotalItensAbaixoMinimo
                    </h3>
                </div>
                <div class="rounded-circle @(Model.TotalItensAbaixoMinimo > 0 ? "bg-danger-subtle text-danger" : "bg-light text-secondary") p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-exclamation-octagon fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Coluna Esquerda: Itens Críticos de Estoque -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h6 class="mb-0 fw-bold text-danger d-flex align-items-center gap-2">
                    <i class="bi bi-bell-fill"></i> Produtos com Estoque Baixo
                </h6>
                <a asp-controller="Produtos" asp-action="Index" class="small text-decoration-none">Ver catálogo &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th class="text-center">Saldo Atual</th>
                            <th class="text-center">Mínimo</th>
                            <th class="text-center">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ProdutosEstoqueCritico.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                                    Nenhum produto em situação crítica de estoque.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ProdutosEstoqueCritico)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Nome</strong>
                                        <small class="d-block text-muted">Cód: @(item.CodigoBarras ?? "S/C")</small>
                                    </td>
                                    <td>@item.Categoria?.Nome</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger fs-6 px-2">@item.QuantidadeEstoque un</span>
                                    </td>
                                    <td class="text-center text-muted fw-semibold">
                                        @item.EstoqueMinimo un
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Produtos" asp-action="EntradaEstoque" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-outline-success">
                                            + Entrada
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Coluna Direita: Vendas Recentes & Meios de Pagamento -->
    <div class="col-lg-5">
        <!-- Vendas Recentes -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history"></i> Vendas Recentes
                </h6>
                <a asp-controller="Vendas" asp-action="Index" class="small text-decoration-none">Ver todas &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @if (!Model.UltimasVendas.Any())
                        {
                            <tr>
                                <td class="text-center text-muted py-3">Nenhuma venda registrada ainda.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var venda in Model.UltimasVendas)
                            {
                                var cancelada = venda.Observacoes?.Contains("[CANCELADA]") ?? false;
                                <tr>
                                    <td class="ps-3 py-2">
                                        <div class="fw-semibold @(cancelada ? "text-decoration-line-through text-muted" : "text-dark")">
                                            Venda #@venda.Id
                                        </div>
                                        <small class="text-muted">@venda.DataVenda.ToLocalTime().ToString("dd/MM HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@venda.FormaPagamento</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <strong class="@(cancelada ? "text-muted" : "text-success")">
                                            @venda.ValorTotal.ToString("C")
                                        </strong>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Divisão por Meios de Pagamento do Dia -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2"></i> Meios de Pagamento (Hoje)
                </h6>
            </div>
            <div class="card-body p-3">
                @if (!Model.FaturamentoPorPagamento.Any())
                {
                    <div class="text-muted small text-center py-2">Nenhuma transação concluída hoje.</div>
                }
                else
                {
                    @foreach (var item in Model.FaturamentoPorPagamento)
                    {
                        var pct = Model.FaturamentoHoje > 0 
                            ? (item.Value / Model.FaturamentoHoje) * 100 
                            : 0;
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small fw-semibold mb-1">
                                <span>@item.Key</span>
                                <span>@item.Value.ToString("C") (@pct.ToString("F0")%)</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @pct.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>