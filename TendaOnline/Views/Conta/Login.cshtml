@model TendaOnline.Models.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso ao Sistema - TendaOnline</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .login-card {
            width: 100%;
            max-width: 950px;
            border-radius: 1.25rem;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
        }

        .brand-panel {
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem 2.5rem;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #0d6efd;
        }

        .input-group-text {
            background-color: #f8fafc;
            border-color: #cbd5e1;
            color: #64748b;
        }

        .form-control {
            border-color: #cbd5e1;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

        .btn-toggle-pass {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: #64748b;
        }

        .btn-toggle-pass:hover {
            background: #f1f5f9;
            color: #0f172a;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="row g-0">
        <!-- Coluna Esquerda: Branding & Destaques (Oculta em celular pequeno) -->
        <div class="col-lg-5 d-none d-lg-flex brand-panel">
            <div>
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="bg-white text-primary rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px;">
                        <i class="bi bi-shop fs-4"></i>
                    </div>
                    <span class="fs-4 fw-bold tracking-tight">TendaOnline</span>
                </div>

                <h3 class="fw-bold lh-sm mb-3">Gestão de Estoque e Vendas com alta performance.</h3>
                <p class="text-white-50 small mb-4">
                    Controle de estoque centralizado, frente de caixa rápida e conciliação por inventário físico em tempo real.
                </p>

                <div class="d-flex flex-column gap-3 mt-4 text-white-75 small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-warning fs-5"></i>
                        <span>Acessos segmentados por permissão</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                        <span>PDV com atualização atômica de saldo</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-spreadsheet text-warning fs-5"></i>
                        <span>Trilha de auditoria completa</span>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-top border-white border-opacity-10 small text-white-50">
                &copy; @DateTime.Now.Year TendaOnline. Todos os direitos reservados.
            </div>
        </div>

        <!-- Coluna Direita: Formulário de Login -->
        <div class="col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center">
            <div class="text-center text-lg-start mb-4">
                <div class="d-lg-none d-inline-flex bg-primary text-white rounded-3 p-2 mb-2">
                    <i class="bi bi-shop fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">Acessar Conta</h4>
                <p class="text-muted small">Informe suas credenciais para gerenciar a loja</p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Alertas de Validação Geral -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>
                            @foreach (var erro in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <span>@erro.ErrorMessage</span>
                            }
                        </div>
                    </div>
                }

                <!-- Campo de E-mail -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary mb-1">E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="nome@tendaonline.com" autofocus required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Campo de Senha -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Senha" class="form-label small fw-semibold text-secondary mb-0">Senha</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Senha" class="form-control" type="password" id="inputSenha" placeholder="Digite sua senha" required />
                        <button class="btn btn-toggle-pass" type="button" id="btnToggleSenha" title="Mostrar/Ocultar Senha">
                            <i class="bi bi-eye" id="iconeOlho"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Senha" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Checkbox Lembrar Me -->
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="LembrarMe" id="lembrarMeCheck" />
                    <label class="form-check-label small text-muted user-select-none" for="lembrarMeCheck">
                        Permanecer conectado
                    </label>
                </div>

                <!-- Botão de Ação -->
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                    <span>Entrar no Sistema</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <!-- Card Informativo de Acesso Rápido -->
            <div class="mt-4 p-3 bg-light rounded-3 border border-secondary-subtle small text-secondary">
                <div class="fw-semibold text-dark mb-1 d-flex align-items-center gap-1">
                    <i class="bi bi-info-circle text-primary"></i> Contas Pré-configuradas:
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-between pt-1">
                    <div>
                        <span class="fw-bold text-dark">Admin:</span> <code>admin@tendaonline.com</code> | <code>Admin@123</code>
                    </div>
                    <div>
                        <span class="fw-bold text-dark">Caixa:</span> <code>caixa@tendaonline.com</code> | <code>Caixa@123</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script para alternar visibilidade da senha -->
<script>
    const btnToggle = document.getElementById('btnToggleSenha');
    const inputSenha = document.getElementById('inputSenha');
    const iconeOlho = document.getElementById('iconeOlho');

    btnToggle.addEventListener('click', () => {
        const isPassword = inputSenha.getAttribute('type') === 'password';
        inputSenha.setAttribute('type', isPassword ? 'text' : 'password');
        
        if (isPassword) {
            iconeOlho.classList.remove('bi-eye');
            iconeOlho.classList.add('bi-eye-slash');
        } else {
            iconeOlho.classList.remove('bi-eye-slash');
            iconeOlho.classList.add('bi-eye');
        }
    });
</script>

</body>
</html>