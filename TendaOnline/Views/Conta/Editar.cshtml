@model TendaOnline.Models.ViewModels.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i> Editar Operador / Usuário
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">E-mail de Login</label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Perfil" class="form-label fw-bold">Nível de Permissão</label>
                        <select asp-for="Perfil" class="form-select" required>
                            <option value="Operador">Operador (Apenas PDV e Vendas)</option>
                            <option value="Admin">Administrador (Acesso Irrestrito)</option>
                        </select>
                        <span asp-validation-for="Perfil" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}