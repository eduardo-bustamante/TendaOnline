@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    // Identifica o controller e action ativos para iluminar o item de menu correspondente
    string ActiveClass(string controller, string action = "")
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        if (string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            if (string.IsNullOrEmpty(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
                return "active text-white bg-primary shadow-sm";
        }
        return "text-secondary";
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TendaOnline</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        /* Sidebar Lateral Fixa */
        #sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        #main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        .nav-link {
            padding: 0.65rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
        }

        .nav-link:hover:not(.active) {
            background-color: #f1f5f9;
            color: #0f172a !important;
        }

        .menu-header {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            padding: 1.2rem 1rem 0.4rem;
        }

        /* @@media escapado para evitar conflito com Razor C# */
        @@media (max-width: 991.98px) {
            #sidebar {
                margin-left: -260px;
            }
            #sidebar.show {
                margin-left: 0;
            }
            #main-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Sidebar Lateral -->
    <aside id="sidebar" class="shadow-sm">
        <!-- Logotipo e Nome do Sistema -->
        <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-shop fs-5"></i>
                </div>
                <div>
                    <span class="fs-5 fw-bold text-dark d-block lh-1">TendaOnline</span>
                    <small class="text-muted" style="font-size: 0.75rem;">Estoque & Vendas</small>
                </div>
            </a>
            <button class="btn btn-sm btn-light d-lg-none" id="sidebarClose" aria-label="Fechar menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Itens de Navegação -->
        <div class="p-3 flex-grow-1 overflow-y-auto">
            <!-- Botão de Ação Rápida: Caixa (PDV) -->
            <div class="mb-3">
                <a asp-controller="Vendas" asp-action="PDV" class="btn btn-success w-100 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm fw-semibold">
                    <i class="bi bi-cart-check-fill fs-5"></i>
                    <span>Abrir Caixa (PDV)</span>
                </a>
            </div>

            <!-- Módulo Geral -->
            <div class="menu-header">Geral</div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link @ActiveClass("Home", "Index")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
            </ul>

            <!-- Módulo de Produtos & Estoque (Apenas Admin vê cadastro, categorias e auditoria) -->
            @if (User.IsInRole("Admin"))
            {
                @if (User.IsInRole("Admin"))
{
    <div class="menu-header">Administração</div>
    <ul class="nav flex-column gap-1 mb-2">
        <li class="nav-item">
            <a class="nav-link @ActiveClass("Conta", "Usuarios")" asp-controller="Conta" asp-action="Usuarios">
                <i class="bi bi-people"></i>
                <span>Usuários & Acessos</span>
            </a>
        </li>
    </ul>
}
                <div class="menu-header">Produtos & Estoque</div>
                <ul class="nav flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Produtos", "Index")" asp-controller="Produtos" asp-action="Index">
                            <i class="bi bi-boxes"></i>
                            <span>Catálogo & Saldos</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Produtos", "Create")" asp-controller="Produtos" asp-action="Create">
                            <i class="bi bi-plus-circle"></i>
                            <span>Novo Produto</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Categorias")" asp-controller="Categorias" asp-action="Index">
                            <i class="bi bi-tags"></i>
                            <span>Categorias</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Movimentacoes")" asp-controller="Movimentacoes" asp-action="Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Extrato / Auditoria</span>
                        </a>
                    </li>
                </ul>
            }

            <!-- Módulo de Vendas -->
            <div class="menu-header">Vendas & Caixa</div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link @ActiveClass("Vendas", "Index")" asp-controller="Vendas" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        <span>Histórico de Vendas</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Rodapé da Sidebar: Usuário Autenticado e Logout -->
        <div class="p-3 border-top bg-light">
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="d-flex align-items-center justify-content-between">
                    <div class="lh-sm text-truncate me-2">
                        <small class="d-block fw-bold text-dark text-truncate" title="@User.Identity?.Name">
                            @User.Identity?.Name
                        </small>
                        <span class="badge @(User.IsInRole("Admin") ? "bg-dark" : "bg-primary")" style="font-size: 0.65rem;">
                            @(User.IsInRole("Admin") ? "Administrador" : "Operador")
                        </span>
                    </div>
                    <form asp-controller="Conta" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Encerrar Sessão">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-muted">Não autenticado</small>
                    <a asp-controller="Conta" asp-action="Login" class="btn btn-sm btn-primary">Entrar</a>
                </div>
            }
        </div>
    </aside>

    <!-- Área de Conteúdo Principal -->
    <div id="main-content">
        <!-- Barra Superior -->
        <header class="bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center sticky-top">
            <button class="btn btn-light d-lg-none" id="sidebarToggle" aria-label="Abrir menu">
                <i class="bi bi-list fs-5"></i>
            </button>

            <!-- Breadcrumb Dinâmico -->
            <div class="d-none d-sm-flex align-items-center gap-2 text-secondary small">
                <i class="bi bi-shop"></i>
                <span>/</span>
                <span class="text-dark fw-semibold">@ViewData["Title"]</span>
            </div>

            <!-- Informações Rápidas -->
            <div class="d-flex align-items-center gap-3 ms-auto">
                <div class="text-end d-none d-md-block">
                    <small class="text-muted d-block" style="font-size: 0.75rem;">Data da Operação</small>
                    <span class="fw-semibold text-dark small">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </header>

        <!-- Corpo Renderizado -->
        <main role="main" class="p-4 flex-grow-1">
            @RenderBody()
        </main>

        <!-- Rodapé do Sistema -->
        <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
            &copy; @DateTime.Now.Year - TendaOnline. Sistema de Controle de Estoque e Vendas.
        </footer>
    </div>

    <!-- Scripts Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Responsividade do menu em celulares/tablets
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const closeBtn = document.getElementById('sidebarClose');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => sidebar.classList.toggle('show'));
        }
        if (closeBtn) {
            closeBtn.addEventListener('click', () => sidebar.classList.remove('show'));
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>